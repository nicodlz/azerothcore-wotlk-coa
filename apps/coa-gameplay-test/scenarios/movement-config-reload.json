{
  "schema": 1,
  "name": "Movement config reload preserves independent player and NPC base speeds",
  "contract": "Reloads preserve run speeds: canonical 7 times the configured rate and creature template multiplier.",
  "players": [
    {
      "id": "player",
      "race": 1,
      "class": 1,
      "level": 20
    }
  ],
  "creatures": [
    {
      "id": "npc",
      "entry": 36,
      "reaction": 0,
      "owner": "player",
      "faction": 35
    }
  ],
  "steps": [
    {
      "action": "assert",
      "actor": "player",
      "metric": "player_controlled",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "player_controlled",
      "equals": 0
    },
    {
      "action": "snapshot",
      "actor": "npc",
      "metric": "run_speed_template_rate",
      "save_as": "npc_template"
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed_rate",
      "ratio_to": "npc_template",
      "min": 0.99999,
      "max": 1.00001
    },
    {
      "action": "snapshot",
      "actor": "player",
      "metric": "run_speed_template_rate",
      "save_as": "player_template"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed_rate",
      "ratio_to": "player_template",
      "min": 0.99999,
      "max": 1.00001
    },
    {
      "action": "snapshot",
      "actor": "player",
      "metric": "run_speed_configured_scale",
      "save_as": "player_config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed",
      "ratio_to": "player_config",
      "min": 6.9999,
      "max": 7.0001
    },
    {
      "action": "snapshot",
      "actor": "player",
      "metric": "run_speed",
      "save_as": "player_initial"
    },
    {
      "action": "snapshot",
      "actor": "npc",
      "metric": "run_speed_configured_scale",
      "save_as": "npc_config"
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed",
      "ratio_to": "npc_config",
      "min": 6.9999,
      "max": 7.0001
    },
    {
      "action": "snapshot",
      "actor": "npc",
      "metric": "run_speed",
      "save_as": "npc_initial"
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed",
      "relative_to": "player_initial",
      "min": -0.0001,
      "max": 0.0001
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed",
      "ratio_to": "player_config",
      "min": 6.9999,
      "max": 7.0001
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed",
      "relative_to": "npc_initial",
      "min": -0.0001,
      "max": 0.0001
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed",
      "ratio_to": "npc_config",
      "min": 6.9999,
      "max": 7.0001
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed",
      "relative_to": "player_initial",
      "min": -0.0001,
      "max": 0.0001
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "run_speed",
      "ratio_to": "player_config",
      "min": 6.9999,
      "max": 7.0001
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed",
      "relative_to": "npc_initial",
      "min": -0.0001,
      "max": 0.0001
    },
    {
      "action": "assert",
      "actor": "npc",
      "metric": "run_speed",
      "ratio_to": "npc_config",
      "min": 6.9999,
      "max": 7.0001
    }
  ]
}
