{
  "schema": 1,
  "name": "PlayerLimit config reload reapplies the configured session cap",
  "contract": "Reload config applies PlayerLimit after each seeded manager limit.",
  "players": [
    {
      "id": "player",
      "race": 1,
      "class": 1,
      "level": 20
    },
    {
      "id": "other",
      "race": 1,
      "class": 1,
      "level": 20
    }
  ],
  "steps": [
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit_config_difference",
      "equals": 0
    },
    {
      "action": "set_session_player_limit",
      "actor": "player",
      "value": 1
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit",
      "equals": 1
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit_config_difference",
      "equals": 0
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "assert",
      "actor": "other",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "set_session_player_limit",
      "actor": "player",
      "value": 2
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit",
      "equals": 2
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit_config_difference",
      "equals": 0
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "assert",
      "actor": "other",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "set_session_player_limit",
      "actor": "player",
      "value": 1
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit",
      "equals": 1
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit_config_difference",
      "equals": 0
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "assert",
      "actor": "other",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "set_session_player_limit",
      "actor": "player",
      "value": 0
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit",
      "equals": 0
    },
    {
      "action": "console",
      "command": "reload config"
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "session_player_limit_config_difference",
      "equals": 0
    },
    {
      "action": "assert",
      "actor": "player",
      "metric": "level",
      "equals": 20
    },
    {
      "action": "assert",
      "actor": "other",
      "metric": "level",
      "equals": 20
    }
  ]
}
